{
    "name": "easydowork/yii2s",
    "description": "Swoole 6 coroutine accelerator for Yii2: resident-memory HTTP server, connection pools, coroutine-safe DB/Redis/Cache/Session components.",
    "keywords": [
        "yii2",
        "swoole",
        "coroutine",
        "connection-pool",
        "http-server",
        "accelerator"
    ],
    "type": "yii2-extension",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-swoole": "^6.0",
        "yiisoft/yii2": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "swoole/ide-helper": "^6.0",
        "yiisoft/yii2-redis": "^2.0",
        "yidas/yii2-composer-bower-skip": "^2.0",
        "friendsofphp/php-cs-fixer": "3.95"
    },
    "autoload": {
        "psr-4": {
            "Yii2S\\Swoole\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "yii2stest\\": "tests/",
            "app\\": "app/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "yidas/yii2-composer-bower-skip": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit --colors=always",
        "static": "phpstan analyse --memory-limit=-1",
        "cs": "php-cs-fixer check --diff",
        "cs-fix": "php-cs-fixer fix"
    }
}
