{
    "name": "easydowork/blog-demo",
    "description": "Real-world blog scenario built on easydowork/yii2s",
    "type": "project",
    "require": {
        "php": ">=8.4",
        "yiisoft/yii2": "^2.0",
        "easydowork/yii2s": "@dev",
        "yiisoft/yii2-redis": "^2.0",
        "yidas/yii2-bower-asset": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "app\\": ""
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../",
            "options": {
                "symlink": true
            }
        }
    ],
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        }
    }
}