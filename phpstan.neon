parameters:
    level: 5
    paths:
        - src
        - tests
    excludePaths:
        - tests/data
        # Same class name as yiisoft/yii2 base/Widget.php. It is loaded only
        # through Yii::$classMap, not as a second definition to analyse.
        - src/Runtime/compat/Widget.php
    scanFiles:
        - vendor/yiisoft/yii2/Yii.php
    scanDirectories:
        - vendor/swoole/ide-helper/src
        - vendor/yiisoft/yii2
    ignoreErrors:
        # YII_DEBUG is defined by the application entry scripts, so phpstan
        # (which sees the test bootstrap) considers the check redundant.
        -
            message: '#If condition is always true#'
            path: src/Server/RequestDispatcher.php
        # The flag is flipped by a separate coroutine phpstan cannot model.
        -
            message: '#will always evaluate to false#'
            path: tests/server/HttpServerGracefulStopTest.php
